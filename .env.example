APP_NAME=AIA Business Knowledge Assistant
APP_VERSION=0.3.1
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://aia:aia@db:5432/aia_knowledge

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.pdf,.txt,.md

EMBEDDING_PROVIDER=jina
JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v5-text-small
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
