APP_NAME=AIA Business Knowledge Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://aia:aia@db:5432/aia_knowledge

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.pdf,.txt,.md

EMBEDDING_PROVIDER=jina
JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v5-text-small
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
ANSWER_TEMPERATURE=0.1
MAX_CONTEXT_CHUNKS=5

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60


LOG_LEVEL=INFO
LOG_JSON=true
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BACKOFF_SECONDS=0.4
REQUEST_SLOW_THRESHOLD_MS=1500


ALLOWED_MIME_TYPES=application/pdf,text/plain,text/markdown
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_MB=12
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ENABLE_HSTS=false
